em; text-transform: uppercase; color: rgb(176, 151, 190); padding: 4px 0px; transition: color 0.25s;\">Work<span style=\"display: flex; color: inherit; transform: none;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></span></button></div><div style=\"position: static;\"><button style=\"display: flex; align-items: center; gap: 5px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; font-family: &quot;Source Sans Pro&quot;, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.52); padding: 4px 0px; transition: color 0.25s;\">Shop<span style=\"display: flex; color: inherit; transform: none;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></span></button></div><button style=\"background: none; border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor transparent; border-image: none; cursor: pointer; font-family: &quot;Source Sans Pro&quot;, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.52); padding: 4px 0px; transition: color 0.25s, border-color 0.25s;\">About</button><button style=\"background: none; border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor transparent; border-image: none; cursor: pointer; font-family: &quot;Source Sans Pro&quot;, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.52); padding: 4px 0px; transition: color 0.25s, border-color 0.25s;\">Gallery</button><button style=\"background: none; border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor transparent; border-image: none; cursor: pointer; font-family: &quot;Source Sans Pro&quot;, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.52); padding: 4px 0px; transition: color 0.25s, border-color 0.25s;\">Blog</button><button tabindex=\"0\" style=\"font-family: &quot;Source Sans Pro&quot;, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(19, 19, 19); background-color: rgb(235, 199, 115); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 2px; padding: 10px 20px; cursor: pointer; display: flex; align-items: center; gap: 7px; flex-shrink: 0;\">Start a Project <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></div><button class=\"nav-m\" aria-label=\"Open navigation\" style=\"background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; color: rgb(235, 199, 115); padding: 8px; align-items: center; justify-content: center;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></nav><div id=\"main-content\"><div style=\"background: rgb(10, 10, 10); overflow: hidden;\"><section class=\"relative min-h-screen flex items-end justify-start overflow-hidden pb-20 md:pb-28 pt-24\"><div class=\"absolute inset-0\" style=\"transform: none;\"><img src=\"/images/sooraj/candy/main.jpg\" alt=\"Kingdom of Sweets arch banner by NicheUX\" class=\"w-full h-full object-cover object-center opacity-35\" loading=\"eager\"></div><div class=\"absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A]/55 to-[#0A0A0A]/20\"></div><div class=\"absolute inset-0 overflow-hidden pointer-events-none\"><div class=\"absolute w-[600px] h-[600px] rounded-full -bottom-40 right-0\" style=\"background: radial-gradient(circle, rgb(247, 197, 159) 0%, transparent 65%); transform: scale(1.16162);\"></div><div class=\"absolute w-[500px] h-[500px] rounded-full top-0 left-0 -translate-x-1/3\" style=\"background: radial-gradient(circle, rgb(176, 151, 190) 0%, transparent 65%); transform: scale(1.03044);\"></div></div><div class=\"relative z-10 max-w-6xl mx-auto px-6 md:px-8 w-full\" style=\"opacity: 1;\"><div class=\"mb-4 flex items-center gap-3\" style=\"opacity: 1; transform: none;\"><span class=\"inline-block px-3 py-1 rounded-full text-xs font-sans-medium uppercase tracking-widest\" style=\"background: rgba(176, 151, 190, 0.125); border: 1px solid rgba(176, 151, 190, 0.25); color: rgb(176, 151, 190);\">Personal · Memory Piece · Ireland</span><span class=\"text-white/50 text-xs font-sans-normal\">Production Nr. 04c</span></div><h1 class=\"font-serif-light text-white leading-[0.88] mb-6\" style=\"font-size: clamp(44px, 7.5vw, 108px); letter-spacing: -0.04em; opacity: 1; transform: none;\">Kingdom of<span class=\"block italic\" style=\"color: rgb(176, 151, 190);\">Sweets</span></h1><p class=\"font-sans-normal text-lg md:text-xl max-w-xl leading-relaxed\" style=\"color: rgba(255, 255, 255, 0.5); opacity: 1; transform: none;\">A place Sooraj worked. A sketch he drew on his phone. A banner for a miniature shop that lives in his home and holds chocolates for anyone who visits.</p></div></section><section class=\"py-16 md:py-20 px-6 md:px-8 border-b border-white/5\"><div class=\"max-w-6xl mx-auto grid md:grid-cols-4 gap-8\"><div><p class=\"text-white/60 text-xs uppercase tracking-widest font-sans-medium mb-1\">For</p><p class=\"text-white font-serif-light text-lg\">Sooraj Nikam</p></div><div><p class=\"text-white/60 text-xs uppercase tracking-widest font-sans-medium mb-1\">Type</p><p class=\"text-white font-serif-light text-lg\">Personal Memory Piece</p></div><div><p class=\"text-white/60 text-xs uppercase tracking-widest font-sans-medium mb-1\">Discipline</p><p class=\"text-white font-serif-light text-lg\">Illustration · Print Design</p></div><div><p class=\"text-white/60 text-xs uppercase tracking-widest font-sans-medium mb-1\">Format</p><p class=\"text-white font-serif-light text-lg\">Arch Banner for Mini Toy Shop</p></div></div></section><section class=\"py-20 md:py-28 px-6 md:px-8\" style=\"background: rgb(241, 233, 210); border-top: 1px solid rgba(26, 26, 26, 0.08);\"><div class=\"max-w-6xl mx-auto\"><div class=\"mb-14\" style=\"opacity: 0; transform: translateY(20px);\"><span class=\"text-xs uppercase tracking-widest font-sans-medium block mb-3\" style=\"color: rgba(176, 151, 190, 0.7);\">The Story</span><h2 class=\"font-serif-light text-4xl md:text-5xl leading-tight\" style=\"color: rgb(26, 26, 26);\">Not every brief is a business brief.</h2></div><div class=\"grid md:grid-cols-2 gap-16 items-start\"><div class=\"space-y-6\" style=\"opacity: 0; transform: translateX(-30px);\"><p class=\"font-sans-normal text-lg leading-relaxed\" style=\"color: rgba(26, 26, 26, 0.75);\">Sooraj Nikam worked at Kingdom of Sweets. When he left, he wanted to keep a piece of it. Not a photograph. Something you could hold.</p><p class=\"font-sans-normal text-lg leading-relaxed\" style=\"color: rgba(26, 26, 26, 0.8);\">He has a miniature toy shop at home. A small model, the kind you put on a shelf. He fills it with chocolates. When someone visits, they can walk over and pick one. That is the Kingdom of Sweets, now.</p><p class=\"font-sans-normal text-lg leading-relaxed\" style=\"color: rgba(26, 26, 26, 0.8);\">He wanted a tiny arch banner for it. Something that looked real, that carried the name and the feeling. He drew the outline himself in a notes app on his phone, sent it over, and asked if we could make it into something.</p><p class=\"font-sans-normal text-lg leading-relaxed\" style=\"color: rgba(26, 26, 26, 0.8);\">We could.</p></div><div style=\"opacity: 0; transform: translateX(30px);\"><div class=\"p-8 rounded-2xl space-y-5\" style=\"background: rgb(255, 255, 255); border: 1px solid rgba(26, 26, 26, 0.1);\"><div style=\"width: 28px; height: 1px; background: rgb(176, 151, 190);\"></div><h3 class=\"font-serif-light text-xl\" style=\"color: rgb(26, 26, 26);\">The brief, in full</h3><blockquote class=\"font-serif-light italic text-lg leading-relaxed\" style=\"color: rgba(26, 26, 26, 0.8); border-left: 2px solid rgba(176, 151, 190, 0.314); padding-left: 16px;\">\"I used to work at Kingdom of Sweets. I have a small toy shop at home that I fill with chocolates for when people visit. I drew the arch banner shape on my phone. Can you make it look real?\"</blockquote><p class=\"font-sans-normal text-sm leading-relaxed\" style=\"color: rgba(26, 26, 26, 0.7);\">Sooraj Nikam, Ireland. The sketch was a notes-app outline. The toy shop was already there, waiting for its banner.</p></div></div></div></div></section><section class=\"py-20 md:py-28 px-6 md:px-8\"><div class=\"max-w-6xl mx-auto\"><div class=\"mb-14\" style=\"opacity: 0; transform: translateY(20px);\"><span class=\"text-xs uppercase tracking-widest font-sans-medium block mb-3\" style=\"color: rgba(176, 151, 190, 0.44);\">From Sketch to Print</span><h2 class=\"font-serif-light text-4xl md:text-5xl text-white\">A notes app drawing becomes a banner.</h2></div><div class=\"grid md:grid-cols-3 gap-6\"><div class=\"p-8 rounded-2xl space-y-4 border border-white/5\" style=\"background: rgba(255, 255, 255, 0.02); opacity: 0; transform: translateY(24px);\"><div class=\"font-serif-light italic\" style=\"font-size: 36px; color: rgba(176, 151, 190, 0.19); line-height: 1;\">01</div><div style=\"width: 28px; height: 1px; background: rgb(176, 151, 190);\"></div><h3 class=\"font-serif-light text-xl text-white\">The sketch</h3><p class=\"font-sans-normal text-sm leading-relaxed text-white/50\">Sooraj drew the arch shape in a phone notes app. A rough outline, the proportions of the banner he had in mind. That was the brief. That shape, made beautiful.</p></div><div class=\"p-8 rounded-2xl space-y-4 border border-white/5\" style=\"background: rgba(255, 255, 255, 0.02); opacity: 0; transform: translateY(24px);\"><div class=\"font-serif-light italic\" style=\"font-size: 36px; color: rgba(233, 198, 114, 0.19); line-height: 1;\">02</div><div style=\"width: 28px; height: 1px; background: rgb(233, 198, 114);\"></div><h3 class=\"font-serif-light text-xl text-white\">The design</h3><p class=\"font-sans-normal text-sm leading-relaxed text-white/50\">We took the arch outline and built a heritage confectionery identity inside it. Warm neutrals, display serif typography, the name Kingdom of Sweets treated as a title card. Something that looked like it had been in business for a century.</p></div><div class=\"p-8 rounded-2xl space-y-4 border border-white/5\" style=\"background: rgba(255, 255, 255, 0.02); opacity: 0; transform: translateY(24px);\"><div class=\"font-serif-light italic\" style=\"font-size: 36px; color: rgba(137, 177, 204, 0.19); line-height: 1;\">03</div><div style=\"width: 28px; height: 1px; background: rgb(137, 177, 204);\"></div><h3 class=\"font-serif-light text-xl text-white\">Two finishes</h3><p class=\"font-sans-normal text-sm leading-relaxed text-white/50\">A clean version and a textured version with paper grain. The texture makes it feel handmade, aged, like something from a real sweet shop window. Both delivered. Sooraj chose based on how it would look printed small.</p></div></div></div></section><section class=\"py-10 md:py-20 px-6 md:px-8\" style=\"background: rgba(255, 255, 255, 0.02);\"><div class=\"max-w-5xl mx-auto\"><div class=\"mb-10\" style=\"opacity: 0; transform: translateY(20px);\"><span class=\"text-xs uppercase tracking-widest font-sans-medium block mb-3\" style=\"color: rgba(176, 151, 190, 0.376);\">The Work</span><h2 class=\"font-serif-light text-4xl md:text-5xl text-white mb-6\">Two versions. One decision.</h2><div style=\"display: flex; gap: 8px; flex-wrap: wrap;\"><button aria-pressed=\"false\" class=\"px-4 py-2 rounded-full text-sm font-sans-medium transition-all bg-white/5 text-white/65 border border-white/10\">Without texture</button><button aria-pressed=\"true\" class=\"px-4 py-2 rounded-full text-sm font-sans-medium transition-all text-[#0A0A0A]\" style=\"background: rgb(176, 151, 190);\">With texture</button></div></div><div><div class=\"rounded-2xl overflow-hidden border border-white/5\" style=\"background: rgb(17, 17, 17); opacity: 1;\"><img src=\"/images/sooraj/candy/texture.png\" alt=\"Kingdom of Sweets. with texture\" class=\"w-full h-auto\" loading=\"lazy\"></div><div class=\"mt-3 inline-block px-3 py-1.5 rounded-full bg-white/5 border border-white/10\"><span class=\"text-white/50 text-xs font-sans-medium\">Paper grain. feels like a real sweet shop print</span></div></div><p class=\"text-white/35 font-sans-normal text-sm leading-relaxed mt-6 max-w-2xl\">The texture version adds a subtle paper grain that makes the design feel handcrafted and aged, right for a brand that is supposed to feel like a memory. The clean version is crisper for small-format print. Both were delivered; Sooraj chose based on what would look best at the scale of the toy shop banner.</p></div></section><section class=\"py-20 md:py-28 px-6 md:px-8\"><div class=\"max-w-6xl mx-auto\"><div class=\"grid md:grid-cols-2 gap-14 items-center\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"rounded-2xl overflow-hidden border border-white/5\"><img src=\"/images/sooraj/candy/main.jpg\" alt=\"Kingdom of Sweets banner by NicheUX\" class=\"w-full h-auto\" loading=\"lazy\"></div><div><div class=\"w-8 h-px mb-6\" style=\"background: rgb(176, 151, 190);\"></div><h3 class=\"font-serif-light text-3xl text-white mb-4\">Heritage by design</h3><p class=\"font-sans-normal text-lg leading-relaxed mb-6 text-white/60\">Kingdom of Sweets needed to feel like it had existed for a long time. Not a modern candy brand, but a sweet shop that had been on the same corner for generations. Display serif typography, warm neutrals, the name treated as a statement.</p><p class=\"font-sans-normal text-base leading-relaxed text-white/65\">The arch shape Sooraj sketched gave the layout its structure. Everything inside it was built to honour what the name meant to him: a real place, full of sweetness, that he wanted to keep forever in a small model on a shelf.</p></div></div></div></section><section class=\"py-20 md:py-28 px-6 md:px-8\" style=\"background: rgb(241, 233, 210); border-top: 1px solid rgba(26, 26, 26, 0.08);\"><div class=\"max-w-4xl mx-auto text-center\"><div style=\"opacity: 0; transform: translateY(30px);\"><span class=\"text-xs uppercase tracking-widest font-sans-medium block mb-4\" style=\"color: rgba(176, 151, 190, 0.44);\">The Outcome</span><h2 class=\"font-serif-light text-4xl md:text-5xl mb-6 leading-tight\" style=\"color: rgb(26, 26, 26);\">A tiny shop. A real memory.</h2><p class=\"font-sans-normal text-xl leading-relaxed mb-10 max-w-2xl mx-auto\" style=\"color: rgba(26, 26, 26, 0.8);\">The banner lives on the miniature toy shop. The shop lives in Sooraj's home, filled with chocolates. Anyone who visits can take one. Kingdom of Sweets is still open.</p><button class=\"inline-flex items-center gap-2 px-6 